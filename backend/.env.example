# Steam Web API Key -> https://steamcommunity.com/dev/apikey
STEAM_API_KEY=DEIN_STEAM_API_KEY

# Öffentliche URL, unter der das Backend erreichbar ist (für den Steam-Login-Redirect)
BASE_URL=http://localhost:3000

# Zufälliger, langer String zum Signieren der Sessions
SESSION_SECRET=bitte-durch-einen-langen-zufaelligen-string-ersetzen

PORT=3000

# Schwellenwerte der Trophäenstufen in Prozent (Anteil aller Spieler).
# Standard: Kupfer ab 30 %, Silber ab 10 %, Gold ab 3 %, darunter Platin.
# Niedrigere Werte machen die höheren Stufen seltener.
TIER_KUPFER_MIN=30
TIER_SILBER_MIN=10
TIER_GOLD_MIN=3

# Relative Einstufung innerhalb eines Spiels:
# Spiele, die viele Leute wirklich durchspielen, haetten nach rein absoluten
# Grenzen nie Gold oder Platin. Deshalb wird zusaetzlich die Stellung eines
# Achievements INNERHALB seines Spiels bewertet - aber nur, wenn das Spiel
# ueberhaupt genug Spreizung hat (leichtestes zu seltenstem Achievement).
# So bleibt ein sehr leichtes Spiel weiterhin komplett Kupfer.
TIER_REL_MIN_SPREAD=2.5

# Obergrenzen: Ein haeufiges Achievement wird nie hochgestuft, auch wenn es
# innerhalb seines Spiels das seltenste ist.
TIER_REL_PLATIN_MAX=25
TIER_REL_GOLD_MAX=45
TIER_REL_SILBER_MAX=70
