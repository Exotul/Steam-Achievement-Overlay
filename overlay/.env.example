# Diese .env ist jetzt die EINZIGE Konfigurationsdatei, die für den
# normalen Gebrauch nötig ist - die Overlay-App startet das Backend
# automatisch mit und reicht diese Werte direkt weiter.

# Steam Web API Key -> https://steamcommunity.com/dev/apikey
STEAM_API_KEY=DEIN_STEAM_API_KEY

# Zufälliger, langer String zum Signieren der Backend-Sessions
SESSION_SECRET=bitte-durch-einen-langen-zufaelligen-string-ersetzen

# Adresse, unter der Backend + Dashboard erreichbar sind
STEAM_APP_BASE_URL=http://localhost:3000

# Wie oft (ms) geprüft wird, ob überhaupt gerade gespielt wird
PRESENCE_POLL_INTERVAL_MS=15000

# Lokale Beschleunigung: beobachtet Dateien, die der Steam-Client selbst auf
# diesem PC ablegt (Logdatei + lokaler Statistik-Zwischenspeicher), um
# Achievements früher zu bemerken als die serverseitig verzögerte Web-API.
# Es wird dabei ausschließlich GELESEN - nichts geschrieben, nichts verändert,
# keine Verbindung zu Steam-Servern, kein Steamworks-SDK.
#   auto = nutzen wenn möglich, sonst nur Web-API   (Empfehlung)
#   off  = ausschließlich Web-API
LOCAL_WATCH=auto

# Wie oft (ms), nachdem ein Spiel erkannt wurde, die Web-API auf neue
# Achievements geprüft wird. Bleibt die verlässliche Grundlage - die lokale
# Beschleunigung kommt oben drauf.
ACHIEVEMENT_POLL_INTERVAL_MS=2000

# Status-Abzeichen unten rechts (Logo + Fortschritt), das anzeigt, dass die
# App laeuft:
#   steam-overlay = nur waehrend Steams Overlay offen ist (Shift+Tab)
#   spiel         = dauerhaft, solange ein Spiel verfolgt wird
#   aus           = nie anzeigen
STATUS_BADGE=steam-overlay

# Wie lange (Sekunden) die Meldung beim Spielstart stehen bleibt.
# Bewusst lang: Beim Spielstart folgen oft noch Ladebildschirme, Logos und
# Menues - eine kurze Einblendung geht dabei unter. Achievement-Meldungen
# bleiben davon unberuehrt (die stehen weiterhin rund 8,5 Sekunden).
GAME_TOAST_SECONDS=30
